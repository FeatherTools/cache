framework: net10.0

source https://api.nuget.org/v3/index.json
nuget FSharp.Core ~> 10.0
nuget Microsoft.Extensions.Caching.StackExchangeRedis ~> 10.0

nuget Feather.ErrorHandling ~> 2.0
nuget Alma.ServiceIdentification ~> 11.0

// [ TESTS GROUP ]
group Tests
    source https://api.nuget.org/v3/index.json
    nuget Expecto
    nuget YoloDev.Expecto.TestSdk
    nuget Microsoft.Extensions.Caching.Memory

// [ FAKE GROUP ]
group Build
    storage none
    source https://api.nuget.org/v3/index.json
    nuget Alma.Build ~> 2.0
